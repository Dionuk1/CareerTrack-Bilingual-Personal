{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "careertrack-local",
  "main": "worker/dist/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "careertrack-local",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "FREEBUFF_CLIENT_ID": "b74187a2-5ed7-48d2-9b9d-fbefa871b333",
    "FREEBUFF_ISSUER": "https://freebuff.com/oidc",
    "APP_ORIGIN": "http://localhost:8787"
  },
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  }
}
