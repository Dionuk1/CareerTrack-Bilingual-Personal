{
  "name": "careertrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:worker",
    "build:worker": "esbuild worker/index.js --bundle --format=esm --platform=neutral --target=es2022 --outfile=worker/dist/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:isolation": "node tests/isolation.test.mjs",
    "test:api": "node tests/api.test.mjs",
    "test": "npm run test:isolation && npm run test:api"
  },
  "dependencies": {
    "@freebuff/auth": "^0.1.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
